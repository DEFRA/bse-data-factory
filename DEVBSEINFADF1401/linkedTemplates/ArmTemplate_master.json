{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "DEVBSEINFADF1401"
		},
		"AmazonRdsForSqlServer1_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "tses.data.dev1.dev.cerespfm.cloud"
		},
		"AmazonRdsForSqlServer1_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "tses"
		},
		"AmazonRdsForSqlServer1_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "tses_bse"
		},
		"AzureKeyVaultRDSTSE_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://DEVBSEINFKV1401.vault.azure.net/"
		},
		"AzureSqlDatabaseBSE_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "devbseinfsq1401.database.windows.net"
		},
		"AzureSqlDatabaseBSE_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "BSE"
		},
		"sqlServer-PE_properties_privateLinkResourceId": {
			"type": "string",
			"defaultValue": "/subscriptions/ec690d8b-e203-4a8f-a7d0-9e21244d23db/resourceGroups/DEVBSEINFRG1401/providers/Microsoft.Sql/servers/DEVBSEINFSQ1401"
		},
		"sqlServer-PE_properties_groupId": {
			"type": "string",
			"defaultValue": "sqlServer"
		},
		"sqlServer-PE_properties_fqdns": {
			"type": "array",
			"defaultValue": [
				"devbseinfsq1401.database.windows.net"
			]
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "DEVBSEINFADF1401_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureKeyVaultRDSTSE_properties_typeProperties_baseUrl": {
						"value": "[parameters('AzureKeyVaultRDSTSE_properties_typeProperties_baseUrl')]"
					},
					"AmazonRdsForSqlServer1_properties_typeProperties_server": {
						"value": "[parameters('AmazonRdsForSqlServer1_properties_typeProperties_server')]"
					},
					"AmazonRdsForSqlServer1_properties_typeProperties_database": {
						"value": "[parameters('AmazonRdsForSqlServer1_properties_typeProperties_database')]"
					},
					"AmazonRdsForSqlServer1_properties_typeProperties_userName": {
						"value": "[parameters('AmazonRdsForSqlServer1_properties_typeProperties_userName')]"
					},
					"sqlServer-PE_properties_privateLinkResourceId": {
						"value": "[parameters('sqlServer-PE_properties_privateLinkResourceId')]"
					},
					"sqlServer-PE_properties_groupId": {
						"value": "[parameters('sqlServer-PE_properties_groupId')]"
					},
					"sqlServer-PE_properties_fqdns": {
						"value": "[parameters('sqlServer-PE_properties_fqdns')]"
					},
					"AzureSqlDatabaseBSE_properties_typeProperties_server": {
						"value": "[parameters('AzureSqlDatabaseBSE_properties_typeProperties_server')]"
					},
					"AzureSqlDatabaseBSE_properties_typeProperties_database": {
						"value": "[parameters('AzureSqlDatabaseBSE_properties_typeProperties_database')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}